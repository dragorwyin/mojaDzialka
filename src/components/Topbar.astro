---
import { Button } from "@/components/ui/button";

const { user } = Astro.locals;
---

<header class="mb-5 flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-app-border bg-app-surface px-4 py-3 text-sm shadow-sm sm:px-5">
  <a href="/" class="font-semibold tracking-tight text-app-foreground transition-colors hover:text-app-accent-strong">
    moja działka
  </a>
  {user ? (
    <div class="flex flex-wrap items-center gap-2 sm:gap-4">
      <span class="max-w-48 truncate text-app-muted" title={user.email}>
        {user.email}
      </span>
      <a
        href="/dashboard"
        class="font-medium text-app-accent-strong transition-colors hover:text-app-accent-hover hover:underline"
      >
        Mój ogród
      </a>
      <form method="POST" action="/api/auth/signout">
        <Button
          type="submit"
          variant="ghost"
          size="sm"
          className="text-app-accent-strong hover:bg-app-page hover:text-app-accent-hover"
        >
          Wyloguj się
        </Button>
      </form>
    </div>
  ) : (
    <nav aria-label="Konto" class="flex items-center gap-2 sm:gap-4">
      <a
        href="/auth/signin"
        class="font-medium text-app-accent-strong transition-colors hover:text-app-accent-hover hover:underline"
      >
        Zaloguj się
      </a>
      <a
        href="/auth/signup"
        class="rounded-full bg-app-accent-strong px-4 py-2 font-medium text-app-accent-foreground transition-colors hover:bg-app-accent-hover"
      >
        Załóż konto
      </a>
    </nav>
  )}
</header>
