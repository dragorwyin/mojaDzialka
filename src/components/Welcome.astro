---
import Topbar from "@/components/Topbar.astro";
import GardenHeroIllustration from "@/components/garden/GardenHeroIllustration.astro";
---

<div class="min-h-screen bg-app-page text-app-foreground">
  <div class="mx-auto max-w-7xl px-4 py-4 sm:px-8 sm:py-7">
    <Topbar />

    <main>
      <section class="grid items-center gap-10 py-10 sm:py-14 lg:grid-cols-2 lg:gap-12 lg:py-16">
        <div class="max-w-xl">
          <p class="mb-5 inline-flex items-center gap-3 text-xs font-semibold tracking-widest text-app-accent-strong uppercase">
            <span class="h-px w-8 bg-app-accent"></span>
            Twój sezon zaczyna się tutaj
          </p>
          <h1 class="font-serif text-5xl leading-none tracking-tight text-app-foreground sm:text-6xl lg:text-7xl">
            Warzywnik, który <span class="text-app-accent-strong italic">rośnie</span> razem z Tobą.
          </h1>
          <p class="mt-6 max-w-lg text-base leading-7 text-app-muted sm:text-lg sm:leading-8">
            Zaplanuj grządki, wybierz ulubione warzywa i zobacz, jak może wyglądać Twój ogród w tym sezonie.
          </p>
          <div class="mt-8 flex flex-col items-start gap-4 sm:flex-row sm:items-center">
            <a
              href="/auth/signup"
              class="inline-flex min-h-12 items-center justify-center gap-3 rounded-full bg-app-accent-strong px-6 py-3 text-sm font-semibold text-app-accent-foreground shadow-sm transition-colors hover:bg-app-accent-hover focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-app-focus"
            >
              Zaplanuj swój ogród <span aria-hidden="true">↗</span>
            </a>
            <a
              href="#jak-to-dziala"
              class="text-sm font-semibold text-app-accent-strong underline decoration-app-accent/30 underline-offset-4 hover:decoration-app-accent"
            >
              Poznaj planer
            </a>
          </div>
          <p class="mt-5 text-xs text-app-muted">
            Masz już konto?{" "}
            <a href="/auth/signin" class="font-semibold text-app-accent-strong hover:underline">
              Zaloguj się
            </a>
          </p>
        </div>

        <figure class="relative mx-auto w-full max-w-2xl">
          <div class="absolute inset-x-8 top-12 aspect-square rounded-full bg-app-soft"></div>
          <div class="relative rounded-3xl border border-app-border/70 bg-app-surface/75 p-3 shadow-xl shadow-app-foreground/5 sm:p-6">
            <GardenHeroIllustration class="relative z-10" />
            <figcaption class="absolute right-3 bottom-3 z-20 rounded-2xl border border-app-border/70 bg-app-surface/95 px-4 py-3 shadow-md sm:right-6 sm:bottom-6 sm:px-5">
              <span class="block text-xs font-semibold tracking-widest text-app-accent-strong uppercase">
                Przykładowy plan
              </span>
              <span class="mt-1 block font-serif text-lg text-app-foreground sm:text-xl">
                Mały ogród, dobry początek
              </span>
              <span class="mt-1 block text-xs text-app-muted">Grządki · warzywa · sezon</span>
            </figcaption>
          </div>
          <span class="absolute top-8 right-8 h-3 w-3 rounded-full bg-app-sun"></span>
          <span class="absolute bottom-20 left-2 h-2 w-2 rounded-full bg-app-accent"></span>
        </figure>
      </section>

      <section
        id="jak-to-dziala"
        class="border-t border-app-border py-9 sm:py-11"
        aria-label="Jak działa planer ogrodu"
      >
        <div class="grid gap-8 sm:grid-cols-3 sm:gap-6">
          <article>
            <span class="font-serif text-2xl text-app-accent">01</span>
            <h2 class="mt-2 text-base font-semibold">Opisz swoją działkę</h2>
            <p class="mt-2 max-w-xs text-sm leading-6 text-app-muted">
              Dodaj wymiary grządek i sektorów, które masz do dyspozycji.
            </p>
          </article>
          <article>
            <span class="font-serif text-2xl text-app-accent">02</span>
            <h2 class="mt-2 text-base font-semibold">Wybierz warzywa</h2>
            <p class="mt-2 max-w-xs text-sm leading-6 text-app-muted">
              Zaznacz uprawy, które chcesz zaprosić do swojego ogrodu.
            </p>
          </article>
          <article>
            <span class="font-serif text-2xl text-app-accent">03</span>
            <h2 class="mt-2 text-base font-semibold">Zobacz plan sezonu</h2>
            <p class="mt-2 max-w-xs text-sm leading-6 text-app-muted">
              Otrzymaj czytelny układ grządek i wracaj do niego w trakcie sezonu.
            </p>
          </article>
        </div>
      </section>
    </main>
  </div>
</div>
