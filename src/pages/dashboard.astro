---
import Layout from "@/layouts/Layout.astro";

const { user } = Astro.locals;
---

<Layout title="Mój ogród">
  <div class="flex min-h-screen items-center justify-center bg-app-page p-4">
    <div class="rounded-2xl border border-app-border bg-app-surface p-8 text-center text-app-foreground shadow-lg shadow-app-foreground/5">
      <h1 class="mb-4 text-3xl font-bold text-app-foreground">Dashboard</h1>
      <p class="text-app-muted">
        Witaj, <span class="font-semibold text-app-foreground">{user?.email}</span>
      </p>
      <p class="mt-2 text-sm text-app-muted">Ta strona jest dostępna po zalogowaniu.</p>
      <a
        href="/garden"
        class="mt-6 inline-flex rounded-full bg-app-accent-strong px-5 py-2.5 text-sm font-semibold text-app-accent-foreground transition-colors hover:bg-app-accent-hover"
      >
        Configure my garden
      </a>
      <form method="POST" action="/api/auth/signout" class="mt-6">
        <button
          type="submit"
          class="rounded-full border border-app-border px-4 py-2 text-sm transition-colors hover:bg-app-page"
        >
          Wyloguj się
        </button>
      </form>
    </div>
  </div>
</Layout>
