---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import { getAuthErrorMessage } from "@/lib/auth-utils";

const error = getAuthErrorMessage(Astro.url.searchParams.get("error"));
---

<Layout title="Rejestracja">
  <div class="flex min-h-screen items-center justify-center bg-app-page p-4">
    <div class="w-full max-w-sm rounded-2xl border border-app-border bg-app-surface p-8 text-app-foreground shadow-lg shadow-app-foreground/5">
      <h1 class="mb-6 text-center text-2xl font-bold text-app-foreground">Sign up</h1>
      <SignUpForm serverError={error} client:load />
      <p class="mt-4 text-center text-sm text-app-muted">
        Already have an account?{" "}
        <a href="/auth/signin" class="font-medium text-app-accent-strong hover:underline">
          Sign in
        </a>
      </p>
    </div>
  </div>
</Layout>
