---
import Layout from "@/layouts/Layout.astro";
import SignUpForm from "@/components/auth/SignUpForm";
import GardenHeroIllustration from "@/components/garden/GardenHeroIllustration.astro";
import { getAuthErrorMessage } from "@/lib/auth-utils";

const error = getAuthErrorMessage(Astro.url.searchParams.get("error"));
---

<Layout title="Rejestracja">
  <main class="min-h-screen bg-app-page px-4 py-5 text-app-foreground sm:px-8 sm:py-8">
    <div class="mx-auto flex max-w-6xl items-center justify-between gap-4">
      <a href="/" class="font-serif text-xl font-semibold tracking-tight text-app-foreground">
        moja działka<span class="text-app-accent">.</span>
      </a>
      <a href="/" class="text-sm font-medium text-app-muted transition-colors hover:text-app-accent-strong">
        Wróć na stronę główną
      </a>
    </div>
    <div class="mx-auto mt-7 grid max-w-6xl overflow-hidden rounded-3xl border border-app-border/80 bg-app-surface shadow-xl shadow-app-foreground/5 lg:mt-12 lg:grid-cols-2">
      <section class="relative isolate flex min-h-52 flex-col justify-between overflow-hidden bg-app-soft px-6 py-7 sm:min-h-64 sm:px-10 sm:py-9 lg:min-h-128 lg:px-14 lg:py-12">
        <div class="absolute -top-24 -right-16 -z-10 size-72 rounded-full border border-app-accent/15"></div>
        <div class="absolute -top-14 -right-6 -z-10 size-52 rounded-full border border-app-accent/15"></div>
        <p class="text-xs font-semibold tracking-widest text-app-accent-strong uppercase">Zacznij od małej grządki</p>
        <div class="absolute inset-y-8 right-0 w-1/2 sm:right-4 lg:inset-x-8 lg:top-auto lg:bottom-0 lg:mx-auto lg:w-full lg:max-w-xl">
          <GardenHeroIllustration />
        </div>
        <p class="relative z-10 mt-10 w-1/2 rounded-2xl border border-app-border/70 bg-app-surface/90 px-3 py-2 font-serif text-lg leading-snug text-app-foreground shadow-sm sm:text-2xl lg:mt-auto lg:w-full lg:max-w-sm lg:px-5 lg:py-4 lg:text-3xl">
          Dobry plan sprawia, że pielęgnacja ogrodu daje jeszcze więcej radości.
        </p>
      </section>
      <section class="flex items-center px-6 py-9 sm:px-10 sm:py-12 lg:px-14">
        <div class="mx-auto w-full max-w-md">
          <p class="mb-3 text-xs font-semibold tracking-widest text-app-accent-strong uppercase">Moja Działka</p>
          <h1 class="font-serif text-4xl tracking-tight text-app-foreground">Załóż konto</h1>
          <p class="mt-3 mb-8 text-sm leading-6 text-app-muted">Stwórz swoje miejsce do planowania warzywnika.</p>
          <SignUpForm serverError={error} client:load />
          <p class="mt-7 text-center text-sm text-app-muted">
            Masz już konto?{" "}
            <a href="/auth/signin" class="font-semibold text-app-accent-strong hover:underline">
              Zaloguj się
            </a>
          </p>
        </div>
      </section>
    </div>
  </main>
</Layout>
