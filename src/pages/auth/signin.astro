---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { getAuthErrorMessage, getSafeReturnTo } from "@/lib/auth-utils";

const error = getAuthErrorMessage(Astro.url.searchParams.get("error"));
const returnTo = getSafeReturnTo(Astro.url.searchParams.get("returnTo"), Astro.url.origin);
---

<Layout title="Logowanie">
  <div class="flex min-h-screen items-center justify-center bg-app-page p-4">
    <div class="w-full max-w-sm rounded-2xl border border-app-border bg-app-surface p-8 text-app-foreground shadow-lg shadow-app-foreground/5">
      <h1 class="mb-6 text-center text-2xl font-bold text-app-foreground">Sign in</h1>
      <SignInForm serverError={error} returnTo={returnTo} client:load />
      <p class="mt-4 text-center text-sm text-app-muted">
        Don't have an account?{" "}
        <a href="/auth/signup" class="font-medium text-app-accent-strong hover:underline">
          Sign up
        </a>
      </p>
    </div>
  </div>
</Layout>
